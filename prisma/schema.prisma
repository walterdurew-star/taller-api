generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT (El Taller) ───────────────────────────
model Tenant {
  id          String   @id @default(uuid())
  nombre      String
  email       String   @unique
  telefono    String?
  direccion   String?
  plan        Plan     @default(FREE)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
  
  usuarios    Usuario[]
  clientes    Cliente[]
  vehiculos   Vehiculo[]
  ordenes     OrdenTrabajo[]
  repuestos   Repuesto[]
  facturas    Factura[]
}

enum Plan {
  FREE
  BASICO
  PRO
}

// ─── USUARIOS DEL TALLER ──────────────────────────
model Usuario {
  id          String   @id @default(uuid())
  tenantId    String
  nombre      String
  email       String
  password    String
  rol         Rol      @default(MECANICO)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
  
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  ordenes     OrdenTrabajo[]
  
  @@unique([email, tenantId])
}

enum Rol {
  ADMIN
  MECANICO
  RECEPCION
}

// ─── CLIENTES ─────────────────────────────────────
model Cliente {
  id          String   @id @default(uuid())
  tenantId    String
  nombre      String
  email       String?
  telefono    String?
  dni         String?
  direccion   String?
  creadoEn    DateTime @default(now())
  
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  vehiculos   Vehiculo[]
  facturas    Factura[]
  
  @@unique([dni, tenantId])
}

// ─── VEHÍCULOS ────────────────────────────────────
model Vehiculo {
  id          String   @id @default(uuid())
  tenantId    String
  clienteId   String
  patente     String
  marca       String
  modelo      String
  anio        Int?
  color       String?
  kilometraje Int?
  creadoEn    DateTime @default(now())
  
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  cliente     Cliente        @relation(fields: [clienteId], references: [id])
  ordenes     OrdenTrabajo[]
  
  @@unique([patente, tenantId])
}

// ─── ORDEN DE TRABAJO ─────────────────────────────
model OrdenTrabajo {
  id              String        @id @default(uuid())
  tenantId        String
  vehiculoId      String
  mecanicoId      String?
  numero          Int
  estado          EstadoOT      @default(RECIBIDO)
  descripcion     String?
  diagnostico     String?
  fechaIngreso    DateTime      @default(now())
  fechaEstimada   DateTime?
  fechaEntrega    DateTime?
  kmIngreso       Int?
  
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  vehiculo        Vehiculo      @relation(fields: [vehiculoId], references: [id])
  mecanico        Usuario?      @relation(fields: [mecanicoId], references: [id])
  items           ItemOrden[]
  factura         Factura?
  
  @@unique([numero, tenantId])
}

enum EstadoOT {
  RECIBIDO
  DIAGNOSTICO
  ESPERANDO_REPUESTOS
  EN_REPARACION
  CONTROL_CALIDAD
  LISTO
  ENTREGADO
}

// ─── ITEMS DE LA ORDEN ────────────────────────────
model ItemOrden {
  id          String      @id @default(uuid())
  ordenId     String
  tipo        TipoItem
  descripcion String
  cantidad    Float       @default(1)
  precioUnit  Float
  repuestoId  String?
  
  orden       OrdenTrabajo @relation(fields: [ordenId], references: [id])
  repuesto    Repuesto?    @relation(fields: [repuestoId], references: [id])
}

enum TipoItem {
  MANO_OBRA
  REPUESTO
  SERVICIO
}

// ─── REPUESTOS / INVENTARIO ───────────────────────
model Repuesto {
  id           String   @id @default(uuid())
  tenantId     String
  codigo       String?
  nombre       String
  descripcion  String?
  stock        Float    @default(0)
  stockMinimo  Float    @default(5)
  precioCompra Float?
  precioVenta  Float
  unidad       String   @default("unidad")
  
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  items       ItemOrden[]
  
  @@unique([codigo, tenantId])
}

// ─── FACTURACIÓN ──────────────────────────────────
model Factura {
  id          String        @id @default(uuid())
  tenantId    String
  ordenId     String        @unique
  clienteId   String
  numero      Int
  subtotal    Float
  impuesto    Float         @default(0)
  total       Float
  estado      EstadoFactura @default(PENDIENTE)
  creadoEn    DateTime      @default(now())
  
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  orden       OrdenTrabajo @relation(fields: [ordenId], references: [id])
  cliente     Cliente      @relation(fields: [clienteId], references: [id])
  
  @@unique([numero, tenantId])
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  ANULADA
}
